{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flicktasks",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flicktasks",
      // `wrangler d1 create flicktasks` の出力で置き換える(ローカル開発はこのままで動く)
      "database_id": "f3ebf0e6-5563-499d-9a8b-1fe215510e19",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "APP_ORIGIN": "https://flicktasks.taichi-nakamura.workers.dev",
    "GOOGLE_CLIENT_ID": "361058386918-dropp0i2pc2hrcpps3i20ms1nq77b0pe.apps.googleusercontent.com"
  },
  // E2E / ローカル専用環境: Workers AI バインディングを外す(ローカル実行では AI は必ずリモート接続 = 認証が必要なため)。
  // MOCK_AI=1 と組み合わせて使う: `CLOUDFLARE_ENV=test vite build && vite preview`
  "env": {
    "test": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "flicktasks",
          "database_id": "f3ebf0e6-5563-499d-9a8b-1fe215510e19",
          "migrations_dir": "migrations"
        }
      ],
      "vars": { "APP_ORIGIN": "http://localhost:4173", "GOOGLE_CLIENT_ID": "" }
    }
  }
}
